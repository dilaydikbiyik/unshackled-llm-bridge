{
  "name": "unshackled-llm-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first, local-only browser extension to fork, sync, and bridge AI conversations across ChatGPT, Claude, and Gemini.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run coverage && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "dexie": "^4.0.11"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.0.310",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
