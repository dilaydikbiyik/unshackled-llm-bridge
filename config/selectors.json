{
  "version": 4,
  "minExtensionVersion": "0.0.1",
  "platforms": {
    "chatgpt": {
      "composer": ["#prompt-textarea", "form div[contenteditable='true']", "#mobile-composer-prompt"],
      "sendButton": ["button[data-testid='send-button']"],
      "messageContainer": ["article[data-testid^='conversation-turn']"],
      "newChatButton": ["a[data-testid='create-new-chat-button']"],
      "modelLabel": ["button[data-testid='model-switcher-dropdown-button']"],
      "dropZone": ["form[data-type='unified-composer']", "main"]
    },
    "claude": {
      "composer": ["div[contenteditable='true'].ProseMirror", "fieldset div[contenteditable='true']"],
      "sendButton": ["button[aria-label='Send message']", "button[aria-label='Mesaj gönder']"],
      "messageContainer": ["div[data-testid='user-message'], .font-claude-response"],
      "userMessage": ["div[data-testid='user-message']"],
      "artifactCell": ["div[data-testid='artifact-block']", "a[aria-label*='artifact' i]"],
      "newChatButton": ["a[href='/new']"],
      "modelLabel": ["button[data-testid='model-selector-dropdown']"],
      "dropZone": ["fieldset", "main"]
    },
    "gemini": {
      "composer": ["rich-textarea div.ql-editor[contenteditable='true']", "div.ql-editor[contenteditable='true']"],
      "sendButton": ["button.send-button", "button[aria-label='Send message']"],
      "messageContainer": ["user-query, model-response"],
      "userMessage": ["user-query"],
      "newChatButton": ["[data-test-id='new-chat-button']", "a[href='/app']"],
      "modelLabel": ["[data-test-id='bard-mode-menu-button']"],
      "dropZone": ["rich-textarea", "main"]
    }
  }
}
