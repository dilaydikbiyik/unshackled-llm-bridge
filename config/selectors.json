{
  "version": 1,
  "minExtensionVersion": "0.0.1",
  "platforms": {
    "chatgpt": {
      "composer": ["#prompt-textarea", "form div[contenteditable='true']"],
      "sendButton": ["button[data-testid='send-button']"],
      "messageContainer": ["article[data-testid^='conversation-turn']"],
      "messageAuthorRole": ["[data-message-author-role]"],
      "newChatButton": ["a[data-testid='create-new-chat-button']"]
    },
    "claude": {
      "composer": ["div[contenteditable='true'].ProseMirror", "fieldset div[contenteditable='true']"],
      "sendButton": ["button[aria-label='Send message']", "button[aria-label='Mesaj gönder']"],
      "messageContainer": ["div[data-testid='chat-message']", "div[data-test-render-count]"],
      "messageAuthorRole": ["[data-message-author]"],
      "newChatButton": ["a[href='/new']"]
    }
  }
}
